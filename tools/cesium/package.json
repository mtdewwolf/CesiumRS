{
  "name": "cesium-rs-tools",
  "private": true,
  "type": "module",
  "description": "Reference CesiumJS for the port: fixture generation and the port tracker.",
  "scripts": {
    "fixtures": "TZ=UTC node fixtures/generate.mjs",
    "tracker": "node tracker.mjs",
    "milestone": "node tracker.mjs --milestone",
    "renderer-assets": "node generate-renderer-assets.mjs",
    "bench:inputs": "node bench/inputs.mjs",
    "bench:node": "node bench/node.mjs --out ../../target/bench-results/cesiumjs-node.json",
    "bench:browser": "node bench/browser.mjs",
    "bench:compare": "node bench/compare.mjs"
  },
  "dependencies": {
    "@cesium/engine": "23.0.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2"
  }
}
